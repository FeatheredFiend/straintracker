# The site is served from public/. On shared hosting this folder usually sits
# inside the main domain's web root (public_html/...), so refuse to serve
# anything from here directly - .env.local holds the database password.
# public/.htaccess grants access again for the app itself.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
